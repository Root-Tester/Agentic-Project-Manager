{
  "name": "agentic-pm",
  "version": "1.0.1",
  "description": "Agentic Project Management CLI",
  "scripts": {
    "build": "node build/index.js",
    "build:release": "node build/index.js",
    "doctor": "node scripts/doctor.js",
    "generate:jwt-secret": "node scripts/generate-jwt-secret.js",
    "dev": "node backend/src/server.js",
    "start:api": "node backend/src/server.js",
    "start:web": "vite --config frontend/vite.config.js frontend --host 0.0.0.0 --port ${PORT:-3000} --strictPort"    "dev:web": "vite --config frontend/vite.config.js frontend",
    "build:web": "vite build --config frontend/vite.config.js frontend",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uknation/Agentic-Project-Manager.git"
  },
  "keywords": [
    "agentic",
    "project-management",
    "cli",
    "apm"
  ],
  "author": "CobuterMan <haidemenoss@gmail.com>",
  "contributors": [],
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "apm": "cli/src/index.js",
    "agentic-pm": "cli/src/index.js"
  },
  "bugs": {
    "url": "https://github.com/uknation/Agentic-Project-Manager/issues"
  },
  "homepage": "https://github.com/uknation/Agentic-Project-Manager#readme",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "7.9.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.18.1",
    "chalk": "5.6.2",
    "commander": "11.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "fs-extra": "11.3.2",
    "jose": "^5.10.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "archiver": "^7.0.1",
    "js-yaml": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "npm:@rollup/wasm-node@^4.66.0",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "mongodb@6.21.0": true
  }
